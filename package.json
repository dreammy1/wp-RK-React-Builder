{
  "name": "rk-react-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": ">=10.4.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,vite \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host\"",
    "dev:mock-wp": "tsx scripts/mock-wp/server.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:php": "php wp-plugin/tests/run.php",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm test:php && pnpm build",
    "test:wp": "RK_WP_INTEGRATION=1 vitest run scripts/wp-integration.test.ts",
    "test:wp-admin": "RK_E2E_WP=1 playwright test -c playwright.wp.config.ts",
    "smoke:wp": "node scripts/wp-smoke.mjs",
    "build:plugin": "pnpm build && node scripts/package-plugin.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "test:plugin": "pnpm test && pnpm test:php",
    "test:all-in-one": "RK_E2E_ALLINONE=1 playwright test -c playwright.allinone.config.ts",
    "build:suite": "node scripts/build-suite.mjs",
    "test:suite": "node scripts/wp-suite.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "lucide-react": "^0.453.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/express": "4.17.21",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.4.1"
}
