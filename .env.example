# Copy to .env for local development. Never commit real values. See DEPLOYMENT.md.

# --- WordPress ---------------------------------------------------------------
# Public URL of the WordPress site (used for CSP image allow-list and admin links).
WORDPRESS_PUBLIC_URL=http://localhost:8099
# REST root the Node server calls (server-to-server; may be an internal address). Must end with /wp-json/.
WORDPRESS_API_URL=http://localhost:8099/wp-json/
# Origin of this frontend as WordPress should allow it in CORS (also accepted as an Origin on editor writes).
WORDPRESS_FRONTEND_ORIGIN=http://localhost:3000
# proxy = builder runs here, writes go through this server holding an application password.
# nonce = builder is embedded in wp-admin and uses the WordPress cookie + X-WP-Nonce; this server only renders the public site.
WORDPRESS_AUTH_MODE=proxy

# proxy mode only: a WordPress user's application password (Users → Profile → Application Passwords).
WORDPRESS_APP_USER=editor
WORDPRESS_APP_PASSWORD=mock-app-password
# proxy mode only: the password editors type to open the builder (>= 12 chars in production).
BUILDER_EDITOR_PASSWORD=change-me-please-123

# --- Public site -------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:3001
PUBLIC_HOME_SLUG=home
SITE_NAME=RK
PUBLIC_CACHE_TTL_SECONDS=60
# Shared with WordPress (RK_BUILDER_REVALIDATE_SECRET). Required in production.
REVALIDATE_SECRET=dev-revalidate-secret
TRUST_PROXY=false
# Failed+successful login attempts allowed per IP per 15 minutes.
LOGIN_RATE_LIMIT_MAX=5

# --- Observability (all optional) --------------------------------------------
SENTRY_DSN=
ANALYTICS_ENDPOINT=
ANALYTICS_WEBSITE_ID=
TELEMETRY_ENABLED=true
# Bearer token for GET /metrics (endpoint is disabled when empty).
METRICS_TOKEN=
